# Database
DATABASE_URL="postgresql://talleres_user:talleres_password@localhost:5432/talleres_mvp?schema=public"

# JWT
# Use a long random value in production. Never use this placeholder in deployed environments.
JWT_ACCESS_SECRET="replace_with_a_long_random_secret_for_local_development"
JWT_ACCESS_EXPIRES_IN_SECONDS="604800"

# CORS
# Comma-separated list when multiple origins are needed.
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Staging only: anchored regex for origins that cannot be listed one by one,
# such as Vercel preview deployments. Leave unset in production.
# CORS_ALLOWED_ORIGIN_PATTERN="^https://talleres-mvp-[a-z0-9-]+-<vercel-scope>\.vercel\.app$"

# Auth cookies
# Local development:
# - sameSite=lax
# - secure=false
#
# Production with web and API on subdomains of the same site
# (www.mitaller360.com + api.mitaller360.com):
# - AUTH_COOKIE_DOMAIN=.mitaller360.com
# - sameSite=lax
# - secure=true
#
# Use sameSite=none only if the frontend runs on a different site
# (e.g. *.vercel.app previews). CSRF is then covered by the Origin check,
# so keep CORS_ALLOWED_ORIGINS exact.
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"

# API tooling
# Keep enabled locally for curl/Postman if needed.
# Disable in production unless there is a deliberate API-client use case.
AUTH_ALLOW_BEARER_TOKENS="true"

# Reverse proxies in front of the API (Render, Cloudflare...).
# Needed so the login rate limiter sees the real client IP.
# Keep 0 locally. Setting more hops than really exist allows IP spoofing.
TRUST_PROXY_HOPS="0"

# Error monitoring (Sentry). Leave empty to disable.
SENTRY_DSN=""
# production | staging. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=""

# Server
PORT="3001"
NODE_ENV="development"