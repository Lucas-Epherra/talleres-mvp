generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  NONE
  OWNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkshopStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlatformAuditAction {
  WORKSHOP_CREATED
  WORKSHOP_DISABLED
  WORKSHOP_ARCHIVED
  WORKSHOP_RESTORED
  WORKSHOP_ENABLED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_RESENT
  INVITATION_ARCHIVED
  USER_ACCESS_DISABLED
  USER_ACCESS_ENABLED
  USER_ROLE_UPDATED
}

enum PlatformAuditEntityType {
  WORKSHOP
  INVITATION
  USER_ACCESS
}

enum WorkshopRole {
  OWNER
  ADMIN
  OPERATOR
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum WorkOrderEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELIVERED
  REOPENED
  CANCELLED
}

enum VehicleEventType {
  ARCHIVED
  RESTORED
}

enum CustomerEventType {
  ARCHIVED
  RESTORED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SupplierMarkupType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
  MANUAL_PRICE
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  MERCADO_PAGO
  CARD
  OTHER
}

enum SupplierEventType {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
  CATEGORY_ASSIGNED
  CATEGORY_REMOVED
  PART_CREATED
  PART_UPDATED
  PART_ARCHIVED
  PAYMENT_CREATED
  PAYMENT_UPDATED
  PAYMENT_VOIDED
}

model Workshop {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  status        WorkshopStatus @default(ACTIVE)
  phone         String?
  email         String?
  address       String?
  logoUrl       String?        @map("logo_url")
  logoObjectKey String?        @map("logo_object_key")
  businessHours String?        @map("business_hours")
  description   String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  archivedAt    DateTime?      @map("archived_at")

  members                     WorkshopMember[]
  customers                   Customer[]
  vehicles                    Vehicle[]
  workOrders                  WorkOrder[]
  receipts                    Receipt[]
  workOrderEvents             WorkOrderEvent[]
  platformAuditLogs           PlatformAuditLog[]
  appointments                Appointment[]
  vehicleEvents               VehicleEvent[]
  customerEvents              CustomerEvent[]
  suppliers                   Supplier[]
  supplierCategories          SupplierCategory[]
  supplierCategoryAssignments SupplierCategoryAssignment[]
  supplierParts               SupplierPart[]
  supplierPayments            SupplierPayment[]
  supplierEvents              SupplierEvent[]
  workOrderPartLines          WorkOrderPartLine[]
  invitations                 Invitation[]

  @@index([status])
  @@index([archivedAt])
  @@map("workshops")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  platformRole PlatformRole @default(NONE) @map("platform_role")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships             WorkshopMember[]
  workOrderEvents         WorkOrderEvent[]
  vehicleEvents           VehicleEvent[]
  archivedVehicles        Vehicle[]          @relation("VehicleArchivedByUser")
  customerEvents          CustomerEvent[]
  archivedCustomers       Customer[]         @relation("CustomerArchivedByUser")
  createdInvitations      Invitation[]       @relation("InvitationCreatedByUser")
  acceptedInvitations     Invitation[]       @relation("InvitationAcceptedByUser")
  platformAuditLogs       PlatformAuditLog[] @relation("PlatformAuditActor")
  issuedReceipts          Receipt[]          @relation("ReceiptIssuedByUser")
  archivedSuppliers       Supplier[]         @relation("SupplierArchivedByUser")
  supplierEvents          SupplierEvent[]
  createdSupplierPayments SupplierPayment[]  @relation("SupplierPaymentCreatedByUser")
  voidedSupplierPayments  SupplierPayment[]  @relation("SupplierPaymentVoidedByUser")

  @@index([platformRole])
  @@index([status])
  @@map("users")
}

model WorkshopMember {
  id         String           @id @default(uuid())
  workshopId String           @map("workshop_id")
  userId     String           @map("user_id")
  role       WorkshopRole     @default(OPERATOR)
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([workshopId])
  @@index([userId])
  @@index([status])
  @@map("workshop_members")
}

model Customer {
  id               String    @id @default(uuid())
  workshopId       String    @map("workshop_id")
  fullName         String    @map("full_name")
  phone            String
  email            String?
  address          String?
  notes            String?
  archivedAt       DateTime? @map("archived_at")
  archivedReason   String?   @map("archived_reason")
  archivedByUserId String?   @map("archived_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workshop       Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  archivedByUser User?           @relation("CustomerArchivedByUser", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  vehicles       Vehicle[]
  events         CustomerEvent[]
  appointments   Appointment[]

  @@unique([workshopId, phone])
  @@index([workshopId])
  @@index([phone])
  @@index([archivedAt])
  @@index([archivedByUserId])
  @@map("customers")
}

model Vehicle {
  id               String    @id @default(uuid())
  workshopId       String    @map("workshop_id")
  customerId       String    @map("customer_id")
  licensePlate     String    @map("license_plate")
  brand            String
  model            String
  year             Int?
  mileage          Int?
  notes            String?
  archivedAt       DateTime? @map("archived_at")
  archivedReason   String?   @map("archived_reason")
  archivedByUserId String?   @map("archived_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workshop       Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  archivedByUser User?          @relation("VehicleArchivedByUser", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  workOrders     WorkOrder[]
  events         VehicleEvent[]
  appointments   Appointment[]

  @@unique([workshopId, licensePlate])
  @@index([workshopId])
  @@index([customerId])
  @@index([archivedAt])
  @@index([archivedByUserId])
  @@map("vehicles")
}

model WorkOrder {
  id             String          @id @default(uuid())
  workshopId     String          @map("workshop_id")
  vehicleId      String          @map("vehicle_id")
  orderNumber    Int             @map("order_number")
  reportedIssue  String          @map("reported_issue")
  diagnosis      String?
  workDone       String?         @map("work_done")
  partsUsed      String?         @map("parts_used")
  entryMileage   Int?            @map("entry_mileage")
  laborCost      Decimal?        @map("labor_cost") @db.Decimal(12, 2)
  partsCost      Decimal?        @map("parts_cost") @db.Decimal(12, 2)
  estimatedTotal Decimal?        @map("estimated_total") @db.Decimal(12, 2)
  finalTotal     Decimal?        @map("final_total") @db.Decimal(12, 2)
  status         WorkOrderStatus @default(PENDING)
  entryDate      DateTime        @default(now()) @map("entry_date")
  deliveryDate   DateTime?       @map("delivery_date")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workshop     Workshop            @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicle      Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  events       WorkOrderEvent[]
  appointments Appointment[]
  receipts     Receipt[]
  partLines    WorkOrderPartLine[]

  @@unique([workshopId, orderNumber])
  @@index([workshopId])
  @@index([vehicleId])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderEvent {
  id          String             @id @default(uuid())
  workshopId  String             @map("workshop_id")
  workOrderId String             @map("work_order_id")
  userId      String?            @map("user_id")
  type        WorkOrderEventType
  fromStatus  WorkOrderStatus?   @map("from_status")
  toStatus    WorkOrderStatus?   @map("to_status")
  description String?
  createdAt   DateTime           @default(now()) @map("created_at")

  workshop  Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([workOrderId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("work_order_events")
}

model VehicleEvent {
  id          String           @id @default(uuid())
  workshopId  String           @map("workshop_id")
  vehicleId   String           @map("vehicle_id")
  userId      String?          @map("user_id")
  type        VehicleEventType
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([vehicleId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("vehicle_events")
}

model CustomerEvent {
  id          String            @id @default(uuid())
  workshopId  String            @map("workshop_id")
  customerId  String            @map("customer_id")
  userId      String?           @map("user_id")
  type        CustomerEventType
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("customer_events")
}

model Appointment {
  id                 String            @id @default(uuid())
  workshopId         String            @map("workshop_id")
  customerId         String?           @map("customer_id")
  vehicleId          String?           @map("vehicle_id")
  workOrderId        String?           @map("work_order_id")
  title              String
  description        String?
  scheduledStart     DateTime          @map("scheduled_start")
  scheduledEnd       DateTime          @map("scheduled_end")
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?           @map("cancellation_reason")
  cancelledAt        DateTime?         @map("cancelled_at")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  workshop  Workshop   @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([workshopId, scheduledStart])
  @@map("appointments")
}

model Supplier {
  id               String    @id @default(uuid())
  workshopId       String    @map("workshop_id")
  name             String
  contactName      String?   @map("contact_name")
  phone            String?
  email            String?
  taxId            String?   @map("tax_id")
  address          String?
  notes            String?
  archivedAt       DateTime? @map("archived_at")
  archivedReason   String?   @map("archived_reason")
  archivedByUserId String?   @map("archived_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workshop            Workshop                     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  archivedByUser      User?                        @relation("SupplierArchivedByUser", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  categoryAssignments SupplierCategoryAssignment[]
  parts               SupplierPart[]
  payments            SupplierPayment[]
  events              SupplierEvent[]
  workOrderPartLines  WorkOrderPartLine[]

  @@unique([workshopId, name])
  @@index([workshopId])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([taxId])
  @@index([archivedAt])
  @@index([archivedByUserId])
  @@map("suppliers")
}

model SupplierCategory {
  id          String    @id @default(uuid())
  workshopId  String    @map("workshop_id")
  name        String
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workshop            Workshop                     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  supplierAssignments SupplierCategoryAssignment[]
  supplierParts       SupplierPart[]

  @@unique([workshopId, name])
  @@index([workshopId])
  @@index([archivedAt])
  @@map("supplier_categories")
}

model SupplierCategoryAssignment {
  id         String   @id @default(uuid())
  workshopId String   @map("workshop_id")
  supplierId String   @map("supplier_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  workshop Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  supplier Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([supplierId, categoryId])
  @@index([workshopId])
  @@index([supplierId])
  @@index([categoryId])
  @@map("supplier_category_assignments")
}

model SupplierPart {
  id                     String              @id @default(uuid())
  workshopId             String              @map("workshop_id")
  supplierId             String              @map("supplier_id")
  categoryId             String?             @map("category_id")
  name                   String
  sku                    String?
  description            String?
  currentCost            Decimal             @map("current_cost") @db.Decimal(12, 2)
  suggestedMarkupType    SupplierMarkupType? @map("suggested_markup_type")
  suggestedMarkupValue   Decimal?            @map("suggested_markup_value") @db.Decimal(12, 2)
  suggestedCustomerPrice Decimal?            @map("suggested_customer_price") @db.Decimal(12, 2)
  isActive               Boolean             @default(true) @map("is_active")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  archivedAt             DateTime?           @map("archived_at")

  workshop           Workshop            @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category           SupplierCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  workOrderPartLines WorkOrderPartLine[]

  @@unique([workshopId, supplierId, name])
  @@index([workshopId])
  @@index([supplierId])
  @@index([categoryId])
  @@index([sku])
  @@index([isActive])
  @@index([archivedAt])
  @@map("supplier_parts")
}

model SupplierPayment {
  id              String                @id @default(uuid())
  workshopId      String                @map("workshop_id")
  supplierId      String                @map("supplier_id")
  createdByUserId String?               @map("created_by_user_id")
  amount          Decimal               @db.Decimal(12, 2)
  paidAt          DateTime              @default(now()) @map("paid_at")
  method          SupplierPaymentMethod @default(OTHER)
  reference       String?
  notes           String?
  voidedAt        DateTime?             @map("voided_at")
  voidedReason    String?               @map("voided_reason")
  voidedByUserId  String?               @map("voided_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  workshop      Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("SupplierPaymentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  voidedByUser  User?    @relation("SupplierPaymentVoidedByUser", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([supplierId])
  @@index([createdByUserId])
  @@index([voidedByUserId])
  @@index([paidAt])
  @@index([method])
  @@index([voidedAt])
  @@map("supplier_payments")
}

model SupplierEvent {
  id          String            @id @default(uuid())
  workshopId  String            @map("workshop_id")
  supplierId  String            @map("supplier_id")
  userId      String?           @map("user_id")
  type        SupplierEventType
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([supplierId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("supplier_events")
}

model WorkOrderPartLine {
  id                   String             @id @default(uuid())
  workshopId           String             @map("workshop_id")
  workOrderId          String             @map("work_order_id")
  supplierId           String?            @map("supplier_id")
  supplierPartId       String?            @map("supplier_part_id")
  partNameSnapshot     String             @map("part_name_snapshot")
  supplierNameSnapshot String?            @map("supplier_name_snapshot")
  quantity             Decimal            @default(1) @db.Decimal(10, 2)
  supplierUnitCost     Decimal            @map("supplier_unit_cost") @db.Decimal(12, 2)
  customerUnitPrice    Decimal            @map("customer_unit_price") @db.Decimal(12, 2)
  markupType           SupplierMarkupType @default(MANUAL_PRICE) @map("markup_type")
  markupValue          Decimal?           @map("markup_value") @db.Decimal(12, 2)
  supplierSubtotal     Decimal            @map("supplier_subtotal") @db.Decimal(12, 2)
  customerSubtotal     Decimal            @map("customer_subtotal") @db.Decimal(12, 2)
  grossProfit          Decimal            @map("gross_profit") @db.Decimal(12, 2)
  purchasedAt          DateTime           @default(now()) @map("purchased_at")
  notes                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  workshop     Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierPart SupplierPart? @relation(fields: [supplierPartId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([workOrderId])
  @@index([supplierId])
  @@index([supplierPartId])
  @@index([purchasedAt])
  @@map("work_order_part_lines")
}

model Invitation {
  id               String           @id @default(uuid())
  workshopId       String           @map("workshop_id")
  email            String
  role             WorkshopRole     @default(ADMIN)
  status           InvitationStatus @default(PENDING)
  tokenHash        String           @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at")
  acceptedAt       DateTime?        @map("accepted_at")
  revokedAt        DateTime?        @map("revoked_at")
  archivedAt       DateTime?        @map("archived_at")
  createdByUserId  String?          @map("created_by_user_id")
  acceptedByUserId String?          @map("accepted_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workshop       Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  createdByUser  User?    @relation("InvitationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedByUser User?    @relation("InvitationAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@index([acceptedByUserId])
  @@index([archivedAt])
  @@map("invitations")
}

model PlatformAuditLog {
  id          String                  @id @default(uuid())
  actorUserId String                  @map("actor_user_id")
  action      PlatformAuditAction
  entityType  PlatformAuditEntityType @map("entity_type")
  entityId    String                  @map("entity_id")
  workshopId  String?                 @map("workshop_id")
  summary     String
  metadata    Json?
  createdAt   DateTime                @default(now()) @map("created_at")

  actorUser User      @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  workshop  Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([workshopId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model Receipt {
  id             String   @id @default(uuid())
  workshopId     String   @map("workshop_id")
  workOrderId    String   @map("work_order_id")
  receiptNumber  Int      @map("receipt_number")
  issuedByUserId String?  @map("issued_by_user_id")
  issuedAt       DateTime @default(now()) @map("issued_at")

  customerSnapshot Json @map("customer_snapshot")
  vehicleSnapshot  Json @map("vehicle_snapshot")
  workSnapshot     Json @map("work_snapshot")

  laborCost Decimal? @map("labor_cost") @db.Decimal(12, 2)
  partsCost Decimal? @map("parts_cost") @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  notes     String?

  emailTo   String?   @map("email_to")
  emailedAt DateTime? @map("emailed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workshop     Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  issuedByUser User?     @relation("ReceiptIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([workshopId, receiptNumber])
  @@unique([workshopId, workOrderId])
  @@index([workshopId])
  @@index([workOrderId])
  @@index([issuedByUserId])
  @@index([issuedAt])
  @@index([emailedAt])
  @@map("receipts")
}
