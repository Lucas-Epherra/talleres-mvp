generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  NONE
  OWNER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkshopStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlatformAuditAction {
  WORKSHOP_CREATED
  WORKSHOP_DISABLED
  WORKSHOP_ARCHIVED
  WORKSHOP_RESTORED
  WORKSHOP_ENABLED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_RESENT
  INVITATION_ARCHIVED
  USER_ACCESS_DISABLED
  USER_ACCESS_ENABLED
  USER_ROLE_UPDATED
}

enum PlatformAuditEntityType {
  WORKSHOP
  INVITATION
  USER_ACCESS
}

enum WorkshopRole {
  OWNER
  ADMIN
  OPERATOR
}

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum WorkOrderEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELIVERED
  REOPENED
  CANCELLED
}

enum VehicleEventType {
  ARCHIVED
  RESTORED
}

enum CustomerEventType {
  ARCHIVED
  RESTORED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Workshop {
  id         String         @id @default(uuid())
  name       String
  slug       String         @unique
  status     WorkshopStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  archivedAt DateTime?      @map("archived_at")

  members           WorkshopMember[]
  customers         Customer[]
  vehicles          Vehicle[]
  workOrders        WorkOrder[]
  receipts          Receipt[]
  workOrderEvents   WorkOrderEvent[]
  platformAuditLogs PlatformAuditLog[]
  appointments      Appointment[]
  vehicleEvents     VehicleEvent[]
  customerEvents    CustomerEvent[]
  invitations       Invitation[]

  @@index([status])
  @@index([archivedAt])
  @@map("workshops")
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  platformRole PlatformRole @default(NONE) @map("platform_role")
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships         WorkshopMember[]
  workOrderEvents     WorkOrderEvent[]
  vehicleEvents       VehicleEvent[]
  archivedVehicles    Vehicle[]          @relation("VehicleArchivedByUser")
  customerEvents      CustomerEvent[]
  archivedCustomers   Customer[]         @relation("CustomerArchivedByUser")
  createdInvitations  Invitation[]       @relation("InvitationCreatedByUser")
  acceptedInvitations Invitation[]       @relation("InvitationAcceptedByUser")
  platformAuditLogs   PlatformAuditLog[] @relation("PlatformAuditActor")
  issuedReceipts      Receipt[]          @relation("ReceiptIssuedByUser")

  @@index([platformRole])
  @@index([status])
  @@map("users")
}

model WorkshopMember {
  id         String           @id @default(uuid())
  workshopId String           @map("workshop_id")
  userId     String           @map("user_id")
  role       WorkshopRole     @default(OPERATOR)
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([workshopId])
  @@index([userId])
  @@index([status])
  @@map("workshop_members")
}

model Customer {
  id               String    @id @default(uuid())
  workshopId       String    @map("workshop_id")
  fullName         String    @map("full_name")
  phone            String
  email            String?
  address          String?
  notes            String?
  archivedAt       DateTime? @map("archived_at")
  archivedReason   String?   @map("archived_reason")
  archivedByUserId String?   @map("archived_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workshop       Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  archivedByUser User?           @relation("CustomerArchivedByUser", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  vehicles       Vehicle[]
  events         CustomerEvent[]
  appointments   Appointment[]

  @@unique([workshopId, phone])
  @@index([workshopId])
  @@index([phone])
  @@index([archivedAt])
  @@index([archivedByUserId])
  @@map("customers")
}

model Vehicle {
  id               String    @id @default(uuid())
  workshopId       String    @map("workshop_id")
  customerId       String    @map("customer_id")
  licensePlate     String    @map("license_plate")
  brand            String
  model            String
  year             Int?
  mileage          Int?
  notes            String?
  archivedAt       DateTime? @map("archived_at")
  archivedReason   String?   @map("archived_reason")
  archivedByUserId String?   @map("archived_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workshop       Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  archivedByUser User?          @relation("VehicleArchivedByUser", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  workOrders     WorkOrder[]
  events         VehicleEvent[]
  appointments   Appointment[]

  @@unique([workshopId, licensePlate])
  @@index([workshopId])
  @@index([customerId])
  @@index([archivedAt])
  @@index([archivedByUserId])
  @@map("vehicles")
}

model WorkOrder {
  id             String          @id @default(uuid())
  workshopId     String          @map("workshop_id")
  vehicleId      String          @map("vehicle_id")
  orderNumber    Int             @map("order_number")
  reportedIssue  String          @map("reported_issue")
  diagnosis      String?
  workDone       String?         @map("work_done")
  partsUsed      String?         @map("parts_used")
  entryMileage   Int?            @map("entry_mileage")
  laborCost      Decimal?        @map("labor_cost") @db.Decimal(12, 2)
  partsCost      Decimal?        @map("parts_cost") @db.Decimal(12, 2)
  estimatedTotal Decimal?        @map("estimated_total") @db.Decimal(12, 2)
  finalTotal     Decimal?        @map("final_total") @db.Decimal(12, 2)
  status         WorkOrderStatus @default(PENDING)
  entryDate      DateTime        @default(now()) @map("entry_date")
  deliveryDate   DateTime?       @map("delivery_date")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workshop     Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  events       WorkOrderEvent[]
  appointments Appointment[]
  receipts     Receipt[]

  @@unique([workshopId, orderNumber])
  @@index([workshopId])
  @@index([vehicleId])
  @@index([status])
  @@map("work_orders")
}

model WorkOrderEvent {
  id          String             @id @default(uuid())
  workshopId  String             @map("workshop_id")
  workOrderId String             @map("work_order_id")
  userId      String?            @map("user_id")
  type        WorkOrderEventType
  fromStatus  WorkOrderStatus?   @map("from_status")
  toStatus    WorkOrderStatus?   @map("to_status")
  description String?
  createdAt   DateTime           @default(now()) @map("created_at")

  workshop  Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([workOrderId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("work_order_events")
}

model VehicleEvent {
  id          String           @id @default(uuid())
  workshopId  String           @map("workshop_id")
  vehicleId   String           @map("vehicle_id")
  userId      String?          @map("user_id")
  type        VehicleEventType
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([vehicleId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("vehicle_events")
}

model CustomerEvent {
  id          String            @id @default(uuid())
  workshopId  String            @map("workshop_id")
  customerId  String            @map("customer_id")
  userId      String?           @map("user_id")
  type        CustomerEventType
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([customerId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("customer_events")
}

model Appointment {
  id                 String            @id @default(uuid())
  workshopId         String            @map("workshop_id")
  customerId         String?           @map("customer_id")
  vehicleId          String?           @map("vehicle_id")
  workOrderId        String?           @map("work_order_id")
  title              String
  description        String?
  scheduledStart     DateTime          @map("scheduled_start")
  scheduledEnd       DateTime          @map("scheduled_end")
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?           @map("cancellation_reason")
  cancelledAt        DateTime?         @map("cancelled_at")
  completedAt        DateTime?         @map("completed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  workshop  Workshop   @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([workshopId, scheduledStart])
  @@map("appointments")
}

model Invitation {
  id               String           @id @default(uuid())
  workshopId       String           @map("workshop_id")
  email            String
  role             WorkshopRole     @default(ADMIN)
  status           InvitationStatus @default(PENDING)
  tokenHash        String           @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at")
  acceptedAt       DateTime?        @map("accepted_at")
  revokedAt        DateTime?        @map("revoked_at")
  archivedAt       DateTime?        @map("archived_at")
  createdByUserId  String?          @map("created_by_user_id")
  acceptedByUserId String?          @map("accepted_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workshop       Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  createdByUser  User?    @relation("InvitationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedByUser User?    @relation("InvitationAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workshopId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@index([acceptedByUserId])
  @@index([archivedAt])
  @@map("invitations")
}

model PlatformAuditLog {
  id          String                  @id @default(uuid())
  actorUserId String                  @map("actor_user_id")
  action      PlatformAuditAction
  entityType  PlatformAuditEntityType @map("entity_type")
  entityId    String                  @map("entity_id")
  workshopId  String?                 @map("workshop_id")
  summary     String
  metadata    Json?
  createdAt   DateTime                @default(now()) @map("created_at")

  actorUser User      @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  workshop  Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([workshopId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

model Receipt {
  id             String   @id @default(uuid())
  workshopId     String   @map("workshop_id")
  workOrderId    String   @map("work_order_id")
  receiptNumber  Int      @map("receipt_number")
  issuedByUserId String?  @map("issued_by_user_id")
  issuedAt       DateTime @default(now()) @map("issued_at")

  customerSnapshot Json @map("customer_snapshot")
  vehicleSnapshot  Json @map("vehicle_snapshot")
  workSnapshot     Json @map("work_snapshot")

  laborCost Decimal? @map("labor_cost") @db.Decimal(12, 2)
  partsCost Decimal? @map("parts_cost") @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  notes     String?

  emailTo   String?   @map("email_to")
  emailedAt DateTime? @map("emailed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workshop     Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  issuedByUser User?     @relation("ReceiptIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([workshopId, receiptNumber])
  @@unique([workshopId, workOrderId])
  @@index([workshopId])
  @@index([workOrderId])
  @@index([issuedByUserId])
  @@index([issuedAt])
  @@index([emailedAt])
  @@map("receipts")
}
